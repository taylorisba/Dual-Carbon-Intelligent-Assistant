APP_NAME=Dual Carbon Intelligent Assistant
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
TIMEZONE=Asia/Shanghai

SQLITE_DB_PATH=./data/app.db
DATA_DIR=./data
DOCUMENTS_DIR=./data/documents
UPLOADS_DIR=./data/uploads
VECTOR_STORE_DIR=./data/vector_store

OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_MODEL=deepseek-r1:8b
EMBEDDING_MODEL=bge-m3
OLLAMA_NUM_CTX=4096
OLLAMA_TOP_K=40
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.5
CONTEXT_MAX_CHARS=6000
QUERY_REWRITE_ENABLED=true

CHUNK_SIZE=500
CHUNK_OVERLAP=80
KEYWORD_TOP_K=8
SEMANTIC_TOP_K=8
FINAL_TOP_K=6
MIN_ANSWERABLE_SCORE=0.32
MAX_CITATIONS=3

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=720
DEFAULT_SYNC_USER_AGENT=dual-carbon-assistant/0.1

EMBEDDING_PROVIDER=ollama
EMBEDDING_PROFILE=auto
EMBEDDING_API=auto
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TRUNCATE=true
EMBEDDING_KEEP_ALIVE=5m
EMBEDDING_DIMENSIONS=0
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
